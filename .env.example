# =============================================================================
# KMITL AI Workspace – environment variables for the unified docker-compose
# Copy to `.env` and fill in real values before `docker compose up`.
# =============================================================================

# SurrealDB (used by open-notebook)
SURREAL_USER=root
SURREAL_PASSWORD=root

# Required for open-notebook: encrypts API keys in the database
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-to-a-secret-string-with-at-least-16-chars

# JWT signing secret for the workspace auth layer.
# Defaults to OPEN_NOTEBOOK_ENCRYPTION_KEY when empty. Set to a dedicated value
# if you want to rotate the secret without re-encrypting API keys.
JWT_SECRET=

# Local workspace administrator created/updated when Open Notebook starts
WORKSPACE_SEED_ADMIN=true
WORKSPACE_SEED_ADMIN_USERNAME=admin1
WORKSPACE_SEED_ADMIN_PASSWORD=admin1

# Optional: gate the open-notebook API behind a shared password
# (matches OPEN_NOTEBOOK_PASSWORD env in api/auth.py)
OPEN_NOTEBOOK_PASSWORD=

# LLM provider keys – picked up by both open-notebook and the standalone apps
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: bump upload limit (default 2048 MB)
# OPEN_NOTEBOOK_MAX_UPLOAD_SIZE_MB=2048

# =============================================================================
# SIET Space – Google Workspace SSO (@kmitl.ac.th) + point wallet
# =============================================================================
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and
# add  ${FRONTEND_URL}/auth/google/callback  as an authorised redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Browser-facing URL of the Next.js frontend
FRONTEND_URL=http://localhost:3000
# Optional override (defaults to ${FRONTEND_URL}/auth/google/callback)
GOOGLE_OAUTH_REDIRECT_URI=
# Only these e-mail domains may sign in
GOOGLE_OAUTH_ALLOWED_DOMAINS=kmitl.ac.th
# DEV ONLY – set to 1 to sign in with any @kmitl.ac.th address without Google
GOOGLE_OAUTH_MOCK=0
# Comma separated e-mails that become admin on sign-in
WORKSPACE_ADMIN_EMAILS=
# Point economy overrides (defaults shown)
# POINTS_WELCOME=20
# POINTS_COST_RAG_QUESTION=1
# POINTS_COST_RAG_SESSION=4
# POINTS_COST_QUIZ_GENERATE=8
# POINTS_COST_ROADMAP_GENERATE=15
# POINTS_COST_QUIZ_IMPORT=1

# Browser-facing URLs of the two standalone apps. Read at runtime by the
# frontend's /config endpoint, so changing the domain needs only a restart.
MY_AI_QUIZ_URL=http://localhost:3001/quiz
AI_ROADMAP_URL=http://localhost:3002/roadmap
# Earning rates (defaults shown)
# POINTS_POST_BONUS=2
# POINTS_LIKE_BONUS=1
# POINTS_SHARE_BONUS=2
# POINTS_EDIT_BONUS=1
# POINTS_LIKE_BONUS_DAILY_CAP=10

# Anti-spam limits for adding content (defaults shown).
# Teachers/admins get SPAM_STAFF_MULTIPLIER x these quotas.
# SPAM_POST_COOLDOWN_SECONDS=20
# SPAM_POST_PER_HOUR=10
# SPAM_POST_PER_DAY=40
# SPAM_COMMENT_COOLDOWN_SECONDS=5
# SPAM_COMMENT_PER_HOUR=30
# SPAM_LIBRARY_COOLDOWN_SECONDS=15
# SPAM_LIBRARY_PER_HOUR=10
# SPAM_LIBRARY_PER_DAY=30
# Student-opened discussion rooms (ห้องพูดคุย).
# SPAM_ROOM_COOLDOWN_SECONDS=60
# SPAM_ROOM_PER_HOUR=2
# SPAM_ROOM_PER_DAY=5
# SPAM_STAFF_MULTIPLIER=4
# SPAM_DUPLICATE_WINDOW_HOURS=24
# SPAM_MIN_POST_CHARS=15
# SPAM_MIN_DOCUMENT_CHARS=80
# SPAM_MIN_ROOM_NAME_CHARS=3
