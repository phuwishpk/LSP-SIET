-- Migration 22: Global Chat Sessions for the /search (Ask) page.
--
-- Unlike ChatSession (scoped to a notebook), GlobalChatSession exists
-- independently of any notebook. This enables the persistent Chat UI
-- on the Ask tab without requiring the user to pick a notebook first.
--
-- User isolation is via owner_id (set at creation time from the auth token).
-- LangGraph checkpoints are stored per-session via thread_id, so existing
-- chat_graph.checkpointer persists messages across requests.

-- =============================================================================
-- 1. Define table and fields
-- =============================================================================
DEFINE TABLE IF NOT EXISTS global_chat_session SCHEMAFULL;

DEFINE FIELD IF NOT EXISTS title        ON global_chat_session TYPE option<string>;
DEFINE FIELD IF NOT EXISTS model_override ON global_chat_session TYPE option<string>;
-- owner_id: per-user isolation — set when a session is created via the API.
DEFINE FIELD IF NOT EXISTS owner_id     ON global_chat_session TYPE option<string>;
DEFINE FIELD IF NOT EXISTS created      ON global_chat_session TYPE datetime DEFAULT time::now();
DEFINE FIELD IF NOT EXISTS updated      ON global_chat_session TYPE datetime DEFAULT time::now();

-- =============================================================================
-- 2. Indexes
-- =============================================================================
DEFINE INDEX IF NOT EXISTS global_chat_session_owner_id
    ON global_chat_session FIELDS owner_id;

-- =============================================================================
-- 3. Backfill: existing rows created before this migration need timestamps.
--    Existing rows will have created=NONE / updated=NONE — fill them now.
-- =============================================================================
UPDATE global_chat_session
    SET created = time::now(), updated = time::now()
WHERE created = NONE OR updated = NONE;
