#!/bin/bash
# Memory per service (RSS, MB) and for the whole container (cgroup).
# usage: docker exec lsp-siet lsp-memcheck
#
# A process belongs to the service whose "s6-supervise <name>" is its nearest
# ancestor. (Command lines do not work: Next 16 renames itself "next-server",
# and /proc/<pid>/cwd of another user needs CAP_SYS_PTRACE.)
declare -A total
service_of() {
  local pid=$1 cmd
  while [ "$pid" -gt 1 ] 2>/dev/null; do
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
    case "$cmd" in "s6-supervise "*) set -- $cmd; echo "$2"; return ;; esac
    pid=$(awk '/^PPid/ {print $2}' "/proc/$pid/status" 2>/dev/null) || break
  done
  echo other
}
for p in /proc/[0-9]*; do
  rss=$(awk '/^VmRSS/ {print $2}' "$p/status" 2>/dev/null)
  [ -z "$rss" ] && continue
  case "$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null)" in s6-*|"") continue ;; esac
  k=$(service_of "${p#/proc/}")
  total[$k]=$(( ${total[$k]:-0} + rss ))
done
sum=0
for k in nginx mariadb surrealdb redis api worker web quiz roadmap other; do
  v=${total[$k]:-0}; sum=$((sum + v))
  printf '%-14s %6d MB\n' "$k" $((v / 1024))
done
printf '%-14s %6d MB\n' "sum(RSS)" $((sum / 1024))
for f in /sys/fs/cgroup/memory.current /sys/fs/cgroup/memory.peak; do
  [ -r "$f" ] && printf '%-14s %6d MB\n' "cgroup:$(basename "$f" | cut -d. -f2)" $(( $(cat "$f") / 1048576 ))
done
exit 0
